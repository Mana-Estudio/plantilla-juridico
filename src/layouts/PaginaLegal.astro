---
import Base from './Base.astro';
import Migas from '../components/Migas.astro';
import { migasJsonld } from '../lib/seo';
interface Props { title: string; description: string; h1: string; actualizado: string; ruta: string }
const { title, description, h1, actualizado, ruta } = Astro.props;
const migas = [{ nombre: h1 }];
---
<Base title={title} description={description} jsonld={[migasJsonld(migas, ruta)]}>
  <Migas items={migas} />
  <section class="cabecera-pagina" aria-labelledby="titulo">
    <div class="contenedor"><p class="etiqueta">Información legal</p><h1 id="titulo">{h1}</h1><p class="secundario">Última actualización: {actualizado}</p></div>
  </section>
  <section class="seccion-corta"><div class="contenedor"><div class="prosa"><slot /></div></div></section>
</Base>
