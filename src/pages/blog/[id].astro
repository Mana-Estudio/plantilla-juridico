---
import type { ImageMetadata } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Foto from '../../components/Foto.astro';
import TeLlamamos from '../../components/TeLlamamos.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { areaPorClave } from '../../data/areas';
import { equipo, despacho } from '../../data/despacho';
import { migasJsonld } from '../../lib/seo';
import { fechaLarga } from '../../lib/calculos';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((articulo) => ({ params: { id: articulo.id }, props: { articulo } }));
}
interface Props { articulo: CollectionEntry<'blog'> }
const { articulo } = Astro.props;
const { Content, headings } = await render(articulo);
const d = articulo.data;
const area = areaPorClave(d.area);
const autor = equipo.find((p) => p.slug === d.autor);
const ruta = `/blog/${articulo.id}/`;
const migas = [{ nombre: 'Blog', href: '/blog/' }, { nombre: d.titulo }];
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/fotos/*.jpg', { eager: true });
const og = fotos[`../../assets/fotos/${d.foto}.jpg`].default;
const palabras = (articulo.body ?? '').split(/\s+/).length;
const jsonArticulo = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.descripcion,
  datePublished: d.fecha.toISOString(),
  dateModified: (d.actualizado ?? d.fecha).toISOString(),
  author: autor ? { '@type': 'Person', name: autor.nombre, jobTitle: autor.cargo } : undefined,
  publisher: { '@id': `${despacho.url}/#despacho` },
  mainEntityOfPage: new URL(ruta, despacho.url).href,
  wordCount: palabras,
};
---
<Base title={d.titulo} description={d.descripcion} og={og} tipoOg="article" whatsapp={area?.whatsapp} jsonld={[migasJsonld(migas, ruta), jsonArticulo]}>
  <div class="barra-lectura" aria-hidden="true"></div>
  <Migas items={migas} />
  <article>
    <header class="contenedor articulo-cabecera">
      <p class="etiqueta">{area?.nombre ?? 'General'}</p>
      <h1>{d.titulo}</h1>
      <p class="entradilla secundario">{d.descripcion}</p>
      <p class="meta"><span>{autor?.nombre}, {autor?.cargo.toLowerCase()}</span><time datetime={d.fecha.toISOString()}>{fechaLarga(d.fecha)}</time><span>{Math.max(1, Math.round(palabras / 220))} min de lectura</span></p>
      <div class="foto-marco marco-cine"><Foto slug={d.foto} prioridad sizes="100vw" /></div>
    </header>
    <div class="contenedor articulo-cuerpo seccion-corta">
      <div class="prosa"><Content /></div>
      <aside class="pegajoso no-imprimir">
        {headings.filter((h) => h.depth === 2).length > 0 && (
          <nav class="indice" aria-label="En este artículo">
            <p class="etiqueta">En este artículo</p>
            <ol>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="seccion-corta"><TeLlamamos area={d.area} id="llamada-articulo" titulo="¿Te pasa algo parecido?" /></div>
      </aside>
    </div>
  </article>
  {area && (
    <section class="seccion fondo-lino" aria-label={`Abogados de ${area.corto.toLowerCase()}`}>
      <div class="contenedor dos-col">
        <div class="cabecera-seccion"><p class="etiqueta">{area.nombre}</p><h2>{area.titulo}</h2></div>
        <div><p class="entradilla">{area.bajada}</p><p><a class="enlace-flecha" href={`/areas/${area.slug}/`}>Ver cómo lo llevamos</a></p></div>
      </div>
    </section>
  )}
  <CtaFinal mensajeWhatsapp={area?.whatsapp} />
</Base>
