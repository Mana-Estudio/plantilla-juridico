---
import Base from '../layouts/Base.astro';
import SelectorProblemas from '../components/SelectorProblemas.astro';
---
<Base title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="contenedor error-404">
    <p class="numero" aria-hidden="true">404</p>
    <h1>Esta página <em>no existe</em></h1>
    <p class="entradilla secundario">Puede que el enlace esté mal o que la hayamos movido. Elige lo que necesitas resolver:</p>
  </section>
  <section class="seccion-corta"><div class="contenedor"><SelectorProblemas /></div></section>
</Base>
