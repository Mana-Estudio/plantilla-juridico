{
  // Cloudflare Workers: sitio estático (dist) + un Worker chico para /api/formulario.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plantilla-juridico",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Demo de Maná: dominio propio sobre manaestudio.ar (gana al comodín *.manaestudio.ar que apunta a Vercel).
  // En la web de un cliente: su dominio.
  "routes": [{ "pattern": "plantilla-juridico.manaestudio.ar", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    // Públicos. Secretos con `wrangler secret put`: RESEND_API_KEY y, si se usa Turnstile, TURNSTILE_SECRET.
    "MAIL_TO": "hola@riosyasociados.example",
    "MAIL_FROM": "Web Ríos & Asociados <web@riosyasociados.example>"
  }
}
