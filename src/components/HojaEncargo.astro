---
// La pieza de la casa: una hoja de encargo que se completa, se firma y se sella con las iniciales del despacho.
import { despacho } from '../data/despacho';
interface Props { filas?: [string, string][]; class?: string }
const { filas = [['Asunto', 'Tu caso, por escrito'], ['Qué haremos', 'Paso a paso, sin letra pequeña'], ['Honorarios', 'Claros antes de empezar'], ['Plazos', 'Te avisamos de cada uno']], class: clase } = Astro.props;
---
<figure class:list={['hoja', clase]} aria-hidden="true">
  <div class="hoja-papel hoja-atras"></div>
  <div class="hoja-papel hoja-frente">
    <p class="hoja-membrete"><span>{despacho.nombre}</span><span>{despacho.sufijo}</span></p>
    <p class="hoja-titulo">Hoja de encargo</p>
    <dl>{filas.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
    <div class="hoja-firma">
      <svg viewBox="0 0 220 60" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 44c14-3 22-22 30-30 6-6 9 2 4 12-6 12-11 22-4 20 9-3 15-20 22-20 5 0 2 13 7 13 6 0 9-11 15-11 5 0 3 9 8 9 7 0 12-13 19-13 4 0 2 8 7 8 9 0 22-6 34-8 14-2 30 0 44-3"/></svg>
      <span>Firma del cliente</span>
    </div>
    <div class="sello"><span>{despacho.iniciales}</span></div>
  </div>
</figure>
