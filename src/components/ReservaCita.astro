---
// Reserva de la primera consulta: modalidad, área, día y hora (de la agenda de despacho.ts) y datos.
// Es una SOLICITUD: el despacho la confirma por teléfono o email (no hay calendario sincronizado).
// Los días se generan en el navegador para que siempre sean los próximos días laborables.
import Consentimiento from './Consentimiento.astro';
import Icono from './Icono.astro';
import { areas } from '../data/areas';
import { despacho } from '../data/despacho';
import { MODALIDADES } from '../lib/formulario';
import { primeraConsulta } from '../data/honorarios';
interface Props { area?: string }
const { area } = Astro.props;
---
<form class="formulario" id="cita" data-form="cita" novalidate data-agenda={JSON.stringify(despacho.agenda)}>
  <input type="hidden" name="tipo" value="cita" />
  <div>
    <p class="formulario-titulo">Pide tu primera consulta</p>
    <p class="secundario">{primeraConsulta.duracion} · {primeraConsulta.precio} € + IVA, que se descuentan si nos encargas el asunto. Te confirmamos la cita por teléfono o email.</p>
  </div>
  <fieldset class="paso">
    <legend class="sub">¿Cómo prefieres la reunión?</legend>
    <div class="opciones">
      {MODALIDADES.map((m, i) => <label class="opcion"><input type="radio" name="modalidad" value={m} required={i === 0} checked={i === 0} /><span>{m}</span></label>)}
    </div>
  </fieldset>
  <div class="campo">
    <label for="cita-area">¿Sobre qué es?</label>
    <select id="cita-area" name="area">
      {areas.map((a) => <option value={a.nombre} selected={a.clave === area}>{a.nombre}</option>)}
      <option value="Otro asunto">Otro asunto</option>
    </select>
  </div>
  <fieldset class="paso">
    <legend class="sub">Elige el día</legend>
    <div class="dias" data-dias><noscript><p>Llámanos al {despacho.contacto.telefono} para pedir cita.</p></noscript></div>
  </fieldset>
  <fieldset class="paso" data-horas-paso hidden>
    <legend class="sub">Y la hora</legend>
    <div class="horas" data-horas></div>
  </fieldset>
  <div class="campos dos">
    <div class="campo"><label for="cita-nombre">Nombre</label><input id="cita-nombre" name="nombre" autocomplete="name" required minlength="2" maxlength="100" /></div>
    <div class="campo"><label for="cita-telefono">Teléfono</label><input id="cita-telefono" name="telefono" type="tel" autocomplete="tel" required pattern="[0-9+\(\)\s.\-]{9,20}" /></div>
  </div>
  <div class="campo"><label for="cita-email">Email <span class="ayuda">(opcional, para mandarte la confirmación)</span></label><input id="cita-email" name="email" type="email" autocomplete="email" maxlength="160" /></div>
  <Consentimiento id="cita" />
  <p class="error-form" role="alert" hidden></p>
  <button class="boton" type="submit" data-evento="cita-enviar"><Icono nombre="calendario" />Pedir la cita</button>
  <div class="listo" role="status" tabindex="-1" hidden></div>
</form>
<script>
  import { enviar, marcarInicio, validarCampos, whatsappCon } from '../scripts/envio';
  import { aInput, fechaLarga, sumarDias, esHabil } from '../lib/calculos';

  const form = document.querySelector<HTMLFormElement>('form[data-form="cita"]');
  if (form) {
    marcarInicio(form);
    const agenda = JSON.parse(form.dataset.agenda ?? '{}') as { dias: number[]; franjas: Record<string, string[]>; diasVista: number };
    const cajaDias = form.querySelector<HTMLElement>('[data-dias]')!;
    const cajaHoras = form.querySelector<HTMLElement>('[data-horas]')!;
    const pasoHoras = form.querySelector<HTMLElement>('[data-horas-paso]')!;
    const error = form.querySelector<HTMLElement>('.error-form')!;
    const listo = form.querySelector<HTMLElement>('.listo')!;

    // Próximos días laborables con agenda (desde mañana; sin fines de semana ni festivos de Madrid).
    const dias: Date[] = [];
    let d = new Date();
    while (dias.length < agenda.diasVista) {
      d = sumarDias(d, 1);
      if (agenda.dias.includes(d.getDay()) && esHabil(d)) dias.push(d);
    }
    const semana = new Intl.DateTimeFormat('es-ES', { weekday: 'short' });
    const mes = new Intl.DateTimeFormat('es-ES', { month: 'short' });
    cajaDias.replaceChildren(...dias.map((dia, i) => {
      const l = document.createElement('label');
      l.className = 'dia';
      l.innerHTML = `<input type="radio" name="fecha" value="${aInput(dia)}" ${i === 0 ? 'required' : ''} aria-label="${fechaLarga(dia)}"><span><small>${semana.format(dia).replace('.', '')}</small><strong>${dia.getDate()}</strong><small>${mes.format(dia).replace('.', '')}</small></span>`;
      return l;
    }));
    cajaDias.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name !== 'fecha') return;
      const [a, m, dd] = input.value.split('-').map(Number);
      const franjas = agenda.franjas[new Date(a, m - 1, dd).getDay()] ?? [];
      cajaHoras.replaceChildren(...franjas.map((h, i) => {
        const l = document.createElement('label');
        l.className = 'hora';
        l.innerHTML = `<input type="radio" name="hora" value="${h}" ${i === 0 ? 'required' : ''}><span>${h}</span>`;
        return l;
      }));
      pasoHoras.hidden = false;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.querySelector('input[name="fecha"]:checked')) { error.textContent = 'Elige un día.'; error.hidden = false; return; }
      if (!form.querySelector('input[name="hora"]:checked')) { error.textContent = 'Elige una hora.'; error.hidden = false; return; }
      if (!validarCampos(form, error)) return;
      const datos = new FormData(form);
      const [a, m, dd] = String(datos.get('fecha')).split('-').map(Number);
      const cuando = `${fechaLarga(new Date(a, m - 1, dd))} a las ${datos.get('hora')}`;
      const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      boton.disabled = true;
      const r = await enviar(form);
      boton.disabled = false;
      if (r.ok) {
        form.querySelectorAll(':scope > :not(.listo)').forEach((n) => ((n as HTMLElement).hidden = true));
        listo.innerHTML = `<span class="marca-ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12.5 4.2 4.2L19 7"/></svg></span><p class="titulo">Solicitud recibida.</p><p>Has pedido cita ${String(datos.get('modalidad')).toLowerCase()} el ${cuando}. Te la confirmamos por teléfono${datos.get('email') ? ' o email' : ''} en horario de despacho.</p>`;
        listo.hidden = false;
        listo.focus();
      } else if (r.sinServidor) {
        const texto = `Hola, soy ${datos.get('nombre')}. Quería pedir cita ${String(datos.get('modalidad')).toLowerCase()} el ${cuando}, sobre ${datos.get('area')}. Mi teléfono: ${datos.get('telefono')}.`;
        error.innerHTML = `No pudimos enviar la solicitud desde aquí. <a href="${whatsappCon(texto)}">Pídela por WhatsApp</a> con los datos ya escritos.`;
        error.hidden = false;
      } else {
        error.textContent = r.mensaje ?? 'No pudimos enviarla. Inténtalo de nuevo o llámanos.';
        error.hidden = false;
      }
    });

    // ?area=laboral preselecciona el área.
    const pedida = new URLSearchParams(location.search).get('area');
    if (pedida) {
      const opcion = [...form.querySelectorAll<HTMLOptionElement>('#cita-area option')].find((o) => o.value.toLowerCase().includes(pedida.toLowerCase()));
      if (opcion) opcion.selected = true;
    }
  }
</script>
