---
// Página de cada área. Las secciones son las mismas, pero cada área trae su herramienta, su foto, sus plazos,
// sus precios y sus casos; Penal suma la franja de urgencia y los derechos del detenido; Empresas, la cuota mensual.
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Foto from '../../components/Foto.astro';
import Icono from '../../components/Icono.astro';
import Proceso from '../../components/Proceso.astro';
import PreciosArea from '../../components/PreciosArea.astro';
import Opiniones from '../../components/Opiniones.astro';
import Casos from '../../components/Casos.astro';
import Faqs from '../../components/Faqs.astro';
import TeLlamamos from '../../components/TeLlamamos.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import TarjetasAreas from '../../components/TarjetasAreas.astro';
import Despido from '../../components/calculadoras/Despido.astro';
import Legitima from '../../components/calculadoras/Legitima.astro';
import Plazos from '../../components/calculadoras/Plazos.astro';
import Intereses from '../../components/calculadoras/Intereses.astro';
import Antecedentes from '../../components/calculadoras/Antecedentes.astro';
import Iguala from '../../components/calculadoras/Iguala.astro';
import ComparadorDivorcio from '../../components/calculadoras/ComparadorDivorcio.astro';
import DerechosDetenido from '../../components/DerechosDetenido.astro';
import { areas, type Area } from '../../data/areas';
import { equipo, despacho, whatsapp } from '../../data/despacho';
import { migasJsonld, faqJsonld, servicioJsonld } from '../../lib/seo';
import IconoWhatsapp from '../../components/IconoWhatsapp.astro';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}
interface Props { area: Area }
const { area } = Astro.props;
const responsable = equipo.find((p) => p.slug === area.responsable)!;
const migas = [{ nombre: 'Áreas', href: '/areas/' }, { nombre: area.nombre }];
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/fotos/*.jpg', { eager: true });
const og = fotos[`../../assets/fotos/${area.foto}.jpg`].default;
const TITULOS: Record<string, [string, string]> = {
  despido: ['Calculadora', '¿Cuánto me corresponde por el despido?'],
  divorcio: ['Los tres caminos', '¿Qué divorcio es el tuyo?'],
  legitima: ['Calculadora', '¿Cómo se reparte la herencia?'],
  plazos: ['Calculadora', '¿Estoy a tiempo de reclamar?'],
  antecedentes: ['Calculadora', '¿Cuándo puedo cancelar mis antecedentes?'],
  intereses: ['Calculadora', '¿Cuánto me debe un cliente con intereses?'],
};
const [etiquetaHerramienta, tituloHerramienta] = TITULOS[area.herramienta];
const iniciales = responsable.nombre.split(/\s+/).slice(0, 2).map((p) => p[0]).join('');
---
<Base title={area.seo.title} description={area.seo.description} og={og} whatsapp={area.whatsapp} urgencia={!!area.urgente}
  jsonld={[migasJsonld(migas, `/areas/${area.slug}/`), faqJsonld(area.preguntas), servicioJsonld(area.nombre, area.bajada, `/areas/${area.slug}/`)]}>
  <Migas items={migas} />
  <section class="cabecera-area" aria-labelledby="titulo">
    <div class="foto-fondo"><Foto slug={area.foto} prioridad sizes="(min-width: 64rem) 50vw, 100vw" /></div>
    <div class="panel" data-entrada>
      <p class="etiqueta">{area.nombre}</p>
      <h1 id="titulo">{area.titulo}</h1>
      <p class="entradilla">{area.bajada}</p>
      <div class="botones">
        {area.urgente
          ? <a class="boton" href={despacho.contacto.urgenciasHref} data-evento="llamar-urgencias"><Icono nombre="telefono" />Guardia 24 h</a>
          : <a class="boton" href={`/contacto/?area=${area.clave}#cita`} data-evento="cita" data-evento-detalle={area.clave}><Icono nombre="calendario" />Pedir cita</a>}
        <a class="boton boton-linea" href={whatsapp(area.whatsapp)} data-evento="whatsapp" data-evento-detalle={area.clave}><IconoWhatsapp />WhatsApp</a>
      </div>
      <ul class="datos-rapidos" role="list">
        <li><a href="#herramienta"><Icono nombre="calculadora" />{tituloHerramienta}</a></li>
        <li><a href="#precios"><Icono nombre="euro" />Precios orientativos</a></li>
      </ul>
    </div>
  </section>

  <section class="seccion" aria-labelledby="situaciones-titulo">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <p class="etiqueta">Situaciones frecuentes</p>
        <h2 id="situaciones-titulo">¿Te encuentras <em>en alguna de estas?</em></h2>
      </header>
      <ol class="situaciones" role="list">
        {area.situaciones.map((s) => <li class="situacion"><h3>{s.titulo}</h3><p>{s.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion fondo-lino" id="herramienta" aria-labelledby="herramienta-titulo">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <p class="etiqueta">{etiquetaHerramienta}</p>
        <h2 id="herramienta-titulo">{tituloHerramienta}</h2>
      </header>
      {area.herramienta === 'despido' && <Despido />}
      {area.herramienta === 'divorcio' && <ComparadorDivorcio />}
      {area.herramienta === 'legitima' && <Legitima />}
      {area.herramienta === 'plazos' && <Plazos inicial="trafico" />}
      {area.herramienta === 'antecedentes' && <Antecedentes />}
      {area.herramienta === 'intereses' && <Intereses />}
    </div>
  </section>

  {area.clave === 'penal' && (
    <section class="seccion fondo-tinta" aria-label="Derechos del detenido"><div class="contenedor"><DerechosDetenido /></div></section>
  )}

  <section class="seccion" aria-labelledby="servicios-titulo">
    <div class="contenedor dos-col">
      <div class="cabecera-seccion pegajoso">
        <p class="etiqueta">Qué llevamos</p>
        <h2 id="servicios-titulo">{area.corto}: <em>todo lo que hacemos</em></h2>
        <div class="responsable">
          <div class="retrato"><span class="iniciales" aria-hidden="true">{iniciales}</span></div>
          <div><p>Responsable del área</p><strong>{responsable.nombre}</strong><p>{responsable.colegiada} · ejerce desde {responsable.desde}</p></div>
        </div>
      </div>
      <ul class="servicios" role="list">
        {area.servicios.map((s) => <li class="servicio"><Icono nombre="check" /><div><h3>{s.nombre}</h3><p>{s.texto}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="seccion fondo-tinta" aria-labelledby="proceso-titulo">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <p class="etiqueta">Paso a paso</p>
        <h2 id="proceso-titulo">Cómo lo llevamos</h2>
      </header>
      <Proceso pasos={area.proceso} />
    </div>
  </section>

  <section class="seccion" aria-labelledby="plazos-titulo">
    <div class="contenedor dos-col">
      <div>
        <header class="cabecera-seccion">
          <p class="etiqueta">Plazos que importan</p>
          <h2 id="plazos-titulo">Que no se te <em>pase la fecha</em></h2>
        </header>
        <table class="tabla-plazos">
          <caption class="oculto">Plazos de {area.nombre.toLowerCase()}</caption>
          <tbody>{area.plazos.map((p) => <tr><th scope="row">{p.asunto}</th><td class="plazo">{p.plazo}</td><td class="nota-plazo">{p.nota}</td></tr>)}</tbody>
        </table>
        <p class="nota"><a class="enlace-flecha" href={`/calculadoras/plazos-para-reclamar/`}>Calcula tu fecha límite</a></p>
      </div>
      <div>
        <header class="cabecera-seccion">
          <p class="etiqueta">Para la primera reunión</p>
          <h2>Qué documentos <em>traer</em></h2>
        </header>
        <ol class="documentos" role="list">{area.documentos.map((d) => <li>{d}</li>)}</ol>
      </div>
    </div>
  </section>

  {area.clave === 'empresas' && (
    <section class="seccion fondo-lino" aria-labelledby="iguala-titulo">
      <div class="contenedor">
        <header class="cabecera-seccion">
          <p class="etiqueta">Asesoría mensual</p>
          <h2 id="iguala-titulo">Un abogado de empresa <em>por una cuota fija</em></h2>
        </header>
        <Iguala />
      </div>
    </section>
  )}

  <section class="seccion" id="precios" aria-labelledby="precios-titulo">
    <div class="contenedor dos-col">
      <div class="cabecera-seccion">
        <p class="etiqueta">Honorarios</p>
        <h2 id="precios-titulo">Cuánto cuesta</h2>
        <p class="secundario">Precios de referencia. Te damos el definitivo por escrito antes de empezar.</p>
        <div class="botones"><a class="boton" href={`/presupuesto/?area=${area.clave}`} data-evento="presupuesto" data-evento-detalle={area.clave}>Calcular mi presupuesto</a></div>
      </div>
      <div><PreciosArea clave={area.clave} /></div>
    </div>
  </section>

  <section class="seccion fondo-lino" aria-labelledby="casos-titulo">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <p class="etiqueta">Casos y opiniones</p>
        <h2 id="casos-titulo">Asuntos de {area.corto.toLowerCase()} <em>que hemos llevado</em></h2>
      </header>
      <Casos area={area.clave} limite={2} />
      <div class="seccion-corta"><Opiniones area={area.clave} limite={3} resumen={false} /></div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="faq-titulo">
    <div class="contenedor dos-col">
      <div>
        <header class="cabecera-seccion">
          <p class="etiqueta">Preguntas frecuentes</p>
          <h2 id="faq-titulo">Lo que más <em>nos preguntan</em></h2>
        </header>
        <TeLlamamos area={area.clave} id={`llamada-${area.clave}`} />
      </div>
      <Faqs preguntas={area.preguntas} />
    </div>
  </section>

  <section class="seccion fondo-lino" aria-labelledby="otras-titulo">
    <div class="contenedor">
      <header class="cabecera-seccion"><p class="etiqueta">Otras áreas</p><h2 id="otras-titulo">También te podemos ayudar con</h2></header>
      <TarjetasAreas excluir={area.slug} />
    </div>
  </section>

  <CtaFinal mensajeWhatsapp={area.whatsapp} />
</Base>
